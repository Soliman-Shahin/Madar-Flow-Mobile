{
  "name": "Madar-Flow",
  "version": "2.0.0",
  "author": "Orbit Madar",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "resources": "capacitor-assets generate",
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "open:android": "npx cap sync android && npx cap open android",
    "build:staging": "ng build --configuration staging",
    "build:prod": "node scripts/assert-production-env.cjs && ng build --configuration production",
    "serve:prod": "ng serve --configuration production",
    "analyze": "source-map-explorer \"dist/**/*.js\"",
    "update-onpush": "node update-onpush.js",
    "postinstall": "node scripts/patch-google-auth.cjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e-report"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@angular/service-worker": "^21.2.17",
    "@capacitor/android": "^8.4.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-native-biometric": "^8.4.11",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@ionic/angular": "^8.8.11",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@revenuecat/purchases-capacitor": "^14.0.0",
    "cordova-plugin-ionic": "5.5.3",
    "crypto-js": "^4.2.0",
    "dexie": "^4.4.4",
    "firebase": "^12.19.0",
    "ionicons": "^7.4.0",
    "ngx-cookie-service": "^18.0.0",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.8.1",
    "web-vitals": "^5.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.16",
    "@angular-eslint/builder": "19.8.1",
    "@angular-eslint/eslint-plugin": "19.8.1",
    "@angular-eslint/eslint-plugin-template": "19.8.1",
    "@angular-eslint/schematics": "19.8.1",
    "@angular-eslint/template-parser": "19.8.1",
    "@angular/cli": "^21.2.16",
    "@angular/compiler-cli": "^21.2.17",
    "@angular/language-service": "^21.2.17",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@ionic/angular-toolkit": "^11.0.1",
    "@playwright/test": "^1.64.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jasmine": "~5.1.15",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "@typescript-eslint/utils": "8.62.0",
    "eslint": "8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jasmine-core": "~5.13.0",
    "jasmine-spec-reporter": "~5.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "rollup": "^4.62.2",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.9.3"
  },
  "description": "Madar Flow Mobile App",
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.2"
  },
  "overrides": {
    "@angular-eslint/builder": "19.8.1",
    "@angular-eslint/eslint-plugin": "19.8.1",
    "@angular-eslint/eslint-plugin-template": "19.8.1",
    "@angular-eslint/schematics": "19.8.1",
    "@angular-eslint/template-parser": "19.8.1",
    "@typescript-eslint/*": "^8.0.0",
    "ngx-cookie-service": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common"
    },
    "@codetrix-studio/capacitor-google-auth": {
      "@capacitor/core": "$@capacitor/core"
    }
  }
}
